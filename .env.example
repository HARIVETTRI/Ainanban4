# GEMINI_API_KEY: Primary AI engine for conversation
# This can be configured in the AI Studio Secrets panel.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# OPENAI_API_KEY: First fallback conversation engine (Optional)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# GROK_API_KEY: Second fallback conversation engine (Optional)
GROK_API_KEY=YOUR_GROK_API_KEY
